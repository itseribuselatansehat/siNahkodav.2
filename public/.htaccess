# ==============================================================================
# SI NAKHODA - Hostinger Production Configuration (.htaccess)
# Puskesmas Kepulauan Seribu Selatan
# ==============================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Rute API PHP
  RewriteRule ^api/system-config/?$ api/system-config.php [L,QSA]
  RewriteRule ^api/database/?$ api/database.php [L,QSA]
  RewriteRule ^dist/api/system-config/?$ dist/api/system-config.php [L,QSA]
  RewriteRule ^dist/api/database/?$ dist/api/database.php [L,QSA]

  # 2. Mencegah rewrite loop pada index.html
  RewriteRule ^index\.html$ - [L]

  # 3. Jika folder dist/ diakses, biarkan dist/.htaccess yang menangani
  RewriteRule ^dist/ - [L]

  # 4. Jika file fisik yang diminta ada secara langsung, sajikan langsung
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Routing SPA standar: arahkan rute halaman lain ke index.html
  RewriteRule . /index.html [L]
</IfModule>

# MIME Types resmi untuk browser
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg .svgz
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Jangan cache index.html agar update selalu langsung terlihat
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Cache-Control"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
